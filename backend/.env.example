# ── Google Gemini ─────────────────────────────────────────────────────────────
# Required — powers all AI analysis (policy extraction, bill checking, RAG chat)
# Get your key: aistudio.google.com → Get API Key
# Models used: gemini-3.6-flash (analysis), gemini-embedding-2-preview (RAG embeddings, 768-dim)
GEMINI_API_KEY=your-gemini-api-key-here

# ── Environment ───────────────────────────────────────────────────────────────
# "development" enables verbose logging; use "production" for demos
ENVIRONMENT=development

# ── Mock mode ─────────────────────────────────────────────────────────────────
# The app refuses to start without GEMINI_API_KEY so it never silently serves
# fake analysis. Set ALLOW_MOCK=1 to run with fake data anyway (e.g. frontend-only work).
# ALLOW_MOCK=1

# ── Storage paths (deployment) ────────────────────────────────────────────────
# On ephemeral hosts (Railway), point these at a mounted persistent volume,
# otherwise all data is lost on every redeploy. Defaults are fine for local dev.
# DB_PATH=/data/heal.db
# UPLOAD_DIR=/data/uploads

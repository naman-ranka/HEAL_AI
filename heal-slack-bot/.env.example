# ── Slack Bot ────────────────────────────────────────────────────────────────
# Get these from https://api.slack.com/apps → your app → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-1-your-app-token-here

# ── HEAL Backend ──────────────────────────────────────────────────────────────
# URL of the FastAPI backend (default: localhost:8000)
HEAL_BACKEND_URL=http://localhost:8000

# ── Thinkn Beliefs SDK ────────────────────────────────────────────────────────
# Hackathon beta access key — get yours at thinkn.ai
BELIEFS_KEY=SVHACK

# ── Gmail (optional — enables dispute letter emails + calendar invites) ───────
# Setup (3 steps, ~2 min):
#   1. Enable 2-Step Verification: myaccount.google.com → Security
#   2. Create App Password: myaccount.google.com → Security → App passwords → "HEAL"
#   3. Paste the 16-character password below (format: xxxx xxxx xxxx xxxx)
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
